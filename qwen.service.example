# Arquivo de serviço systemd para Servidor Qwen
# 
# Instalação:
# 1. Edite este arquivo e ajuste os caminhos
# 2. Copie para: sudo cp qwen.service.example /etc/systemd/system/qwen.service
# 3. Recarregue: sudo systemctl daemon-reload
# 4. Inicie: sudo systemctl start qwen
# 5. Habilite no boot: sudo systemctl enable qwen
#
# Comandos úteis:
# - Ver status: sudo systemctl status qwen
# - Ver logs: sudo journalctl -u qwen -f
# - Parar: sudo systemctl stop qwen
# - Reiniciar: sudo systemctl restart qwen

[Unit]
Description=Qwen Local AI Server
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/caminho/para/qwen-local
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
User=seu-usuario
Group=docker

[Install]
WantedBy=multi-user.target
