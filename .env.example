# Configuração do Servidor Qwen Local
# =====================================

# Porta do Ollama (API REST)
OLLAMA_PORT=11434

# Porta da Interface Web
WEBUI_PORT=3000

# Número de requisições paralelas que o Ollama pode processar
OLLAMA_NUM_PARALLEL=2

# Número máximo de modelos carregados simultaneamente na memória
OLLAMA_MAX_LOADED_MODELS=1

# Tempo que o modelo fica carregado na memória após uso
OLLAMA_KEEP_ALIVE=5m

# Autenticação na interface web (true/false)
WEBUI_AUTH=false
